rule password_spray {
  meta:
    author = "GoogleSecOps-Lab"
    rule_id = "GSL008"
    description = "Password spray from one IP"
    severity = "HIGH"
    mitre_attack = "T1110.003"
    validation = "PENDING"

  events:
    $e.metadata.event_type = "USER_LOGIN"
    $e.metadata.product_name = /^(Workspace|Entra ID|Windows Security|sshd)$/
    $e.security_result.action = "BLOCK"
    $key0 = $e.principal.ip
    $distinct_value = $e.target.user.userid
    $e.target.user.userid != ""

  match:
    $key0 over 10m

  condition:
    #distinct_value >= 5
}
