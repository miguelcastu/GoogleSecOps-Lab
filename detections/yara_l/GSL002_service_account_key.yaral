rule service_account_key {
  meta:
    author = "GoogleSecOps-Lab"
    rule_id = "GSL002"
    description = "Service account key creation"
    severity = "HIGH"
    mitre_attack = "T1098.001"
    validation = "PENDING"

  events:
    $e.metadata.event_type = "RESOURCE_CREATION"
    $e.metadata.product_name = "Cloud Audit Logs"
    $e.metadata.product_event_type = /(?:^|[.])CreateServiceAccountKey$/ nocase
    $e.security_result.action = "ALLOW"

  condition:
    $e
}
